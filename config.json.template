{
  "source_dir": "love.life.coocan.jp",
  "output_dir": "out",
  "work_dir": "work",
  "lang": {
    "source": "ja",
    "target": "zh-Hans"
  },
  "llm": {
    "provider": "openai-compatible",
    "base_url": "https://api.openai.com/v1",
    "model": "gpt-4o-mini",
    "api_key_env": "BOOKTR_API_KEY",
    "api_key": "",
    "api_key_required": true,
    "temperature": 0.3,
    "max_tokens": 131072,
    "max_tokens_ceiling": 524288,
    "timeout": 300,
    "connect_timeout": 20,
    "stream": true,
    "reasoning_effort": "",
    "max_retries": 3,
    "max_requests_per_minute": 60,
    "max_repair": 3,
    "max_history_segments": 50,
    "summary_enabled": true,
    "retranslate_context_chars": 1000,
    "retranslate_use_summary": true,
    "auto_retranslate": true,
    "auto_retranslate_attempts": 1
  },
  "planner": {
    "static_first": true,
    "diary_chronological": true,
    "context": {
      "plan_predecessors": 5,
      "time_predecessors": 3,
      "link_predecessors": 3,
      "link_hops_weight": 3.0,
      "link_plan_weight": 1.0,
      "hops_min": 2,
      "hops_max": 8,
      "plan_dist_min": 1,
      "plan_dist_max": 128,
      "max_chars": 1500
    },
    "survey_enabled": false,
    "summarize": true,
    "weights": {
      "semantic": 1.0,
      "has_semantic": 0.0,
      "is_orphan": 0.0,
      "is_index": 0.0,
      "hotness": 0.0,
      "depth": 0.0,
      "chrono": 0.0,
      "volume": 0.0,
      "nav": 0.0,
      "dfs": 0.0,
      "len": 0.0
    },
    "directions": {
      "semantic": "forward",
      "chrono": "forward",
      "volume": "forward",
      "nav": "forward",
      "dfs": "forward",
      "len": "forward"
    },
    "index_threshold": 0.6
  },
  "segments": {
    "block_tags": [
      "p", "div", "blockquote", "table", "tr", "td", "th", "li", "ul", "ol",
      "h1", "h2", "h3", "h4", "h5", "h6", "center", "pre", "hr",
      "dl", "dt", "dd", "form", "option", "select", "title", "html",
      "head", "body"
    ],
    "translate_alt": true,
    "translate_title": true,
    "placeholder_open": "[[P",
    "placeholder_close": "]]",
    "min_text_len": 1
  },
  "glossary": {
    "path": "work/glossary.json",
    "auto_extract": true,
    "extract_pages_limit": 0
  },
  "style": {
    "refs_path": "style_refs.json",
    "guide_path": "work/style_guide.md",
    "rules_enabled": true,
    "exemplar_enabled": true,
    "exemplar_topk": 3
  },
  "notes": {
    "path": "work/notes.jsonl"
  },
  "phrases": {
    "path": "work/phrase_memory.json",
    "max_len": 30
  },
  "tm": {
    "path": "work/tm.jsonl",
    "enabled": true
  },
  "qa": {
    "deep_llm_check": true,
    "queue_path": "work/qa_queue.json",
    "report_dir": "work/qa_reports",
    "reasoning_effort": "",
    "supervisor": {
      "enabled": true,
      "provider": "",
      "base_url": "",
      "model": "",
      "api_key_env": "",
      "api_key": "",
      "api_key_required": null,
      "temperature": 0.1,
      "max_tokens": 131072,
      "timeout": 120,
      "max_retries": 1,
      "reasoning_effort": null,
      "include_all_summaries": true,
      "all_summaries_max_chars": 65536,
      "multi_turn": true,
      "log": true
    },
    "auto_log_dir": "work/qa_auto_runs"
  },
  "translators_notes": {
    "path": "work/translators_notes.json",
    "focus": ""
  },
  "review": {
    "path": "work/review_queue.json",
    "auto_regenerate": true
  },
  "state": {
    "path": "work/state.json"
  },
  "summaries": {
    "dir": "work/summaries"
  },
  "segments_dir": "work/segments",
  "segment_history": {
    "enabled": true,
    "dir": "work/segment_history"
  },
  "llm_logs": {
    "dir": "work/llm_logs",
    "auto_export": true,
    "auto_export_sessions": 1
  },
  "mode": "auto",
  "pause_on_review": true,
  "chunk_size": 600,
  "verbose_translation": true,
  "user_rules": "保留原文中的全角写法：全角英文字母（Ａ-Ｚ, ａ-ｚ）、全角数字（０-９）、全角符号（！？～・＆＊＝＋＜＞等）保持全角不转半角，与 CJK 字符混排时全角形式融合更好；几何符号（●○■）、省略号（…）、破折号（――）、日文角引号（「」）、智能引号（“”‘’）保持原样。英文/拉丁字母不翻译；人名、地名、机构名等专名应译出中文（音译或意译），可附原文于括号内，避免仅保留日文原形。"
}
